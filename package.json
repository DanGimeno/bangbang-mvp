{
  "name": "bangbang",
  "private": true,
  "version": "0.1.0",
  "description": "BANG! BANG! — The Vocal Shooter. Your mouth is the trigger.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && vite build"
  },
  "dependencies": {
    "@babylonjs/core": "^9.38.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
